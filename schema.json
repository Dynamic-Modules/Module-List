{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic Modules Registry",
  "type": "object",
  "required": [
    "modules"
  ],
  "properties": {
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "repo"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "default_branch": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "compat": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "latest_version": {
            "type": "string"
          },
          "module_api": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
